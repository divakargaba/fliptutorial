#!/usr/bin/env bash
# Create or find this project's Message Board and remember its issue number.
# Run from Git Bash on Windows, or a terminal on macOS/Linux.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
command -v gh >/dev/null || { echo 'Install GitHub CLI: https://cli.github.com' >&2; exit 1; }
gh auth status >/dev/null 2>&1 || { echo 'Run gh auth login, then tools/setup.' >&2; exit 1; }
repo=$(gh repo view --json nameWithOwner --jq .nameWithOwner)
issue="${BOARD_ISSUE:-}"
if (( $# )); then
  [[ "$1" == --issue && $# == 2 ]] || { echo 'Usage: tools/setup [--issue N]' >&2; exit 1; }
  issue="$2"
fi
if [[ -z "$issue" ]]; then
  matches=$(gh issue list -R "$repo" --state open --search '"Message Board" in:title' --json number,title --jq '.[] | select(.title == "Message Board") | .number')
  if [[ "$matches" == *$'\n'* ]]; then
    echo 'Multiple Message Board issues found. Run tools/setup --issue N.' >&2; exit 1
  fi
  issue="$matches"
fi
if [[ -z "$issue" ]]; then
  body=$(mktemp); trap 'rm -f "$body"' EXIT
  awk 'NR==1 && $0=="---" {front=1; next} front && $0=="---" {front=0; next} !front {print}' .github/ISSUE_TEMPLATE/message-board.md > "$body"
  url=$(gh issue create -R "$repo" --title 'Message Board' --body-file "$body")
  issue="${url##*/}"
fi
[[ "$issue" =~ ^[1-9][0-9]*$ ]] || { echo 'Invalid board issue number.' >&2; exit 1; }
[[ "$(gh issue view "$issue" -R "$repo" --json state --jq .state)" == OPEN ]] || { echo 'The board must be open.' >&2; exit 1; }
printf '%s\n' "$issue" > .board-issue
if ! gh issue pin "$issue" -R "$repo"; then
  echo 'Board works; ask the repository owner to pin the issue.' >&2
fi
echo "Board ready: https://github.com/$repo/issues/$issue"
echo 'Commit .board-issue if it changed, then teammates pull.'
tools/board whoami
