# npm run setup creates .env.local at the REPOSITORY ROOT without overwriting it.
# Fill values there. Empty optional fields are not exported to child tools.
# Use literal values; quote values containing # or newlines. No shell commands.

# APP: these are the only public values. Next.js embeds them in the browser build.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# APP SERVER: optional privileged database access. Prefer user-scoped access.
# Use the modern secret key, or the legacy service-role key if your project needs it.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI: choose ONE provider and its model when the prompt arrives.
# LLM_PROVIDER: openai | anthropic | gemini | deepseek
LLM_PROVIDER=
LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
# A server-side demo access secret, if the product uses a shared demo gate.
DEMO_ACCESS_TOKEN=

# AGENT TOOLS: Supabase management, schema changes and deployment.
# Personal access token and project ref; these differ from the app's API keys.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
# Optional direct Postgres access for tools that actually need a connection string.
DATABASE_URL=

# OPTIONAL AWS: use an existing SSO/profile OR a temporary credential set.
# Complete SSO login beforehand when using AWS_PROFILE. Do not mix both methods.
AWS_PROFILE=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# OPTIONAL GITHUB: normally gh auth login / Git Credential Manager already handles this.
GH_TOKEN=

# DEPLOYMENT: Vercel hosts the Next.js UI AND API routes. See docs/DEPLOYMENT.md.
# Token: Vercel account token with access to the event project's team.
# IDs: Vercel Project Settings / General (owner/team ID and project ID).
# Agent-only credentials: never upload these as app runtime env variables.
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
# Optional: existing protection bypass for automated checks of protected previews.
# Used as the x-vercel-protection-bypass request header; agent-only, never app env.
VERCEL_AUTOMATION_BYPASS_SECRET=
