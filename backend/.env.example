# Anthropic (prep `scan` and the Test-me generator). Put your own key in the
# gitignored backend/.env only; never commit, post or print it.
ANTHROPIC_API_KEY=
# Model for prep scan (and Test-me unless ANTHROPIC_TESTME_MODEL is set).
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional faster model for Test-me (stretch scope, off by default), e.g. claude-haiku-5-5.
ANTHROPIC_TESTME_MODEL=

# Judge0 CE (code grading)
JUDGE0_BASE_URL=https://ce.judge0.com
JUDGE0_PYTHON_LANGUAGE_ID=71
# If the Judge0 host requires auth, set one of these:
JUDGE0_AUTH_TOKEN=
JUDGE0_AUTH_HEADER=X-Auth-Token
