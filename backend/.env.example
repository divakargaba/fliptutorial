# Gemini (used only by the prep pipeline)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Test-me generator (stretch scope, off by default)
# gemini-2.5-flash is recommended: it supports thinking (needed for quality) and
# its free tier allows 5 req/min, 20 req/day. gemini-flash-latest has more quota
# but returns 503 under load and does not support thinking.  Cache hits are free
# so 20/day is enough for T7 (3 clean runs × 2 videos ≈ 6–12 generations).
GEMINI_TESTME_MODEL=gemini-2.5-flash
# Thinking budget for the generator (-1 = model default, 0 = off, >0 = token cap)
GEMINI_TESTME_THINKING=1024

# Judge0 CE (code grading)
JUDGE0_BASE_URL=https://ce.judge0.com
JUDGE0_PYTHON_LANGUAGE_ID=71
# If the Judge0 host requires auth, set one of these:
JUDGE0_AUTH_TOKEN=
JUDGE0_AUTH_HEADER=X-Auth-Token
