# Anthropic (prep `scan` and the Test-me generator). Put your own key in the
# gitignored backend/.env only; never commit, post or print it.
ANTHROPIC_API_KEY=
# Model for prep scan.
ANTHROPIC_MODEL=claude-sonnet-5-5
# Model for Test me (independent of ANTHROPIC_MODEL; Haiku for latency).
ANTHROPIC_TESTME_MODEL=claude-haiku-5-5

# Judge0 CE (code grading)
JUDGE0_BASE_URL=https://ce.judge0.com
JUDGE0_PYTHON_LANGUAGE_ID=71
# If the Judge0 host requires auth, set one of these:
JUDGE0_AUTH_TOKEN=
JUDGE0_AUTH_HEADER=X-Auth-Token
# Hint coach (/v1/hints) and efficiency review (/v1/analysis). Default: claude-opus-5-5.
ANTHROPIC_HINT_MODEL=
ANTHROPIC_ANALYSIS_MODEL=
ADZUNA_APP_KEY=
ADZUNA_APP_ID=
# Test me is enabled by default. Set false only to disable it.
# BREAKPOINT_TESTME=false
